# Generated by GD++, do not edit.

import sys

# Keeps godot-cpp/ free of __pycache__, so it stays a plain copy of the bindings.
sys.dont_write_bytecode = True

# With --gdpp-bindings, only godot-cpp's bindings are generated (not compiled), for GD++ to scan their headers.
# An option, not a variable, so godot-cpp doesn't warn about an unknown variable.
AddOption("--gdpp-bindings", dest="gdpp_bindings", action="store_true", help="only generate godot-cpp's bindings")
# Warnings in the package's sources, but not in godot-cpp's, are errors, or with --gdpp-nowarn, disabled.
AddOption("--gdpp-nowarn", dest="gdpp_nowarn", action="store_true", help="disable warnings")
# With --gdpp-sanitize, the package's sources, but not godot-cpp's, are compiled with these sanitizers, e.g. address,undefined.
AddOption("--gdpp-sanitize", dest="gdpp_sanitize", type="string", default="", help="sanitizers to compile in")
# With --gdpp-nogpu, shaders run on the CPU.
AddOption("--gdpp-nogpu", dest="gdpp_nogpu", action="store_true", help="run shaders on the CPU")

package_root = ".."
# Copies of the package's GD++ and C/C++ files, which GD++ syncs before each build, so errors show the compiled code.
sources_root = "package"
project_root = {{printf "%q" .ProjectRoot}}

# godot-cpp builds into build/godot-cpp, since GD++ overwrites godot-cpp/ on each build.
env = Environment(tools=["default"], PLATFORM="")
env["custom_api_file"] = File("#extension_api.json").abspath
env = SConscript("godot-cpp/SConstruct", exports="env", variant_dir="build/godot-cpp", duplicate=False)

if GetOption("gdpp_bindings"):
    Default(None)
    Default(Dir("build/godot-cpp/gen"))
else:
    env = env.Clone()
    env["CXXFLAGS"] = [f for f in env["CXXFLAGS"] if not str(f).startswith(("-std=", "/std:"))]
    env.Append(CXXFLAGS=[("/std:" if env.get("is_msvc", False) else "-std=") + {{printf "%q" .CppStandard}}])
    # Quoted includes are relative to the package root, <> ones to the project root, and both find gdpp, which holds the
    # C++ that GD++ generates from .gd++ files. MSVC can't tell quotes from <>, so there both find the package root too.
    env.Append(CPPPATH=[project_root, "gdpp"])
    if not env.get("is_msvc", False):
        # The package root is passed as -iquote, but stays in CPPPATH, so SCons still finds the headers it depends on.
        env["GDPP_INCPATH"] = list(env["CPPPATH"])
        env["_CPPINCFLAGS"] = "-iquote " + sources_root + " " + env["_CPPINCFLAGS"].replace("CPPPATH", "GDPP_INCPATH")
    env.Prepend(CPPPATH=[sources_root])
    # The name of the package's class of tasks, which Async types name.
    env.Append(CPPDEFINES=[("GDPP_ASYNC_CLASS", {{printf "%q" .AsyncClass}})])
    # The name of the package's runner of tests, which gd++ test runs.
    env.Append(CPPDEFINES=[("GDPP_TESTS_CLASS", {{printf "%q" .TestsClass}})])
    # How long its tasks may still run after the game started quitting, from its quit_timeout setting.
    env.Append(CPPDEFINES=[("GDPP_QUIT_TIMEOUT_USEC", {{.QuitTimeout}})])
    # The names of the package's class of GPU arrays, which GpuArray types name, and of the textures that shaders create.
    env.Append(CPPDEFINES=[("GDPP_GPU_ARRAY_CLASS", {{printf "%q" .GpuArrayClass}}), ("GDPP_GPU_TEXTURE_CLASS", {{printf "%q" .GpuTextureClass}})])
    if GetOption("gdpp_nogpu"):
        env.Append(CPPDEFINES=["GDPP_GPU_FORCE_CPU"])
    if GetOption("gdpp_nowarn"):
        env.Append(CCFLAGS=["/w" if env.get("is_msvc", False) else "-w"])
    else:
        env.Append(CCFLAGS=["/WX" if env.get("is_msvc", False) else "-Werror"])
    sanitizers = GetOption("gdpp_sanitize")
    if sanitizers and env.get("is_msvc", False):
        if sanitizers != "address":
            print("MSVC only supports AddressSanitizer.")
            Exit(1)
        env.Append(CCFLAGS=["/fsanitize=address"])
    elif sanitizers and env.get("use_mingw", False):
        print("MinGW doesn't support sanitizers.")
        Exit(1)
    elif sanitizers:
        flags = ["-fsanitize=" + sanitizers, "-fno-omit-frame-pointer"]
        env.Append(CCFLAGS=flags, LINKFLAGS=flags)
    # godot-cpp's headers refuse to compile with a sanitizer unless its macro is defined.
    macros = {"address": "ASAN_ENABLED", "undefined": "UBSAN_ENABLED", "thread": "TSAN_ENABLED"}
    env.Append(CPPDEFINES=[macros[s] for s in sanitizers.split(",") if s])
{{- if .Color}}
    # GD++ pipes the output, so colors must be forced; $( $) keeps the flag out of
    # the build signature, so it doesn't trigger rebuilds.
    if not env.get("is_msvc", False):
        env.Append(CCFLAGS=["$(", "-fdiagnostics-color=always", "$)"])
{{- end}}

    objects = "build/" + env["suffix"][1:] + "/"
    # Object names keep the source's extension, so foo.c and foo.cpp don't clash.
    sources = [env.SharedObject(objects + "__register_types__.cpp" + env["SHOBJSUFFIX"], "__register_types__.cpp")]
{{- range .Sources}}
    sources.append(env.SharedObject(objects + "package/" + {{printf "%q" .}} + env["SHOBJSUFFIX"], sources_root + "/" + {{printf "%q" .}}))
{{- end}}

    # The C++ that GD++ generates, a source per class. Those of @test classes are only for debug builds.
    for source in Glob("gdpp/*.cpp"):
        sources.append(env.SharedObject(objects + "gdpp/" + source.name + env["SHOBJSUFFIX"], source))
    if env["target"] != "template_release":
        for source in Glob("gdpp/test/*.cpp"):
            sources.append(env.SharedObject(objects + "gdpp/test/" + source.name + env["SHOBJSUFFIX"], source))

    # Class documentation, which GD++ generates from doc comments, unless it's turned off.
    docs = Glob("gdpp/doc_classes/*.xml")
    if docs:
        doc_data = env.GodotCPPDocData("build/doc_data.gen.cpp", source=docs)
        sources.append(env.SharedObject(objects + "doc_data.gen.cpp" + env["SHOBJSUFFIX"], doc_data))

    # Named e.g. libfoo.linux.debug.x86_64.so, shorter than godot-cpp's suffix.
    name = ".".join(["lib" + {{printf "%q" .Id}}, env["platform"], env["target"].replace("template_", ""), env["arch"]])
    library = env.SharedLibrary(package_root + "/" + name + env["SHLIBSUFFIX"], sources)
    env.NoCache(library)
    Default(library)
