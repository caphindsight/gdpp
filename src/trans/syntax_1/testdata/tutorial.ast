      - @273:1
        Func: @274:1
          Annotations:
            - @273:1 onthread
          Name: count_primes
          Params:
            - @274:19
              Name: limit
              Type: @274:26 int
          Return: @274:34 int
          Body: @274:38
            TextPos: 274:39
            Text: |

                int64_t count = 0;
                for (int64_t n = 2; n < limit; n++) {
                  bool prime = true;
                  if (is_cancelled) {
                    return count;
                  }
                  for (int64_t d = 2; d * d <= n && prime; d++) {
                    prime = n % d != 0;
                  }
                  count += prime;
                }
                return count;

