      - @280:1
        Func: @281:1
          Annotations:
            - @280:1 onthread
          Name: count_primes
          Params:
            - @281:19
              Name: limit
              Type: @281:26 int
          Return: @281:34 int
          Body: @281:38
            TextPos: 281:39
            Text: |

                int64_t count = 0;
                for (int64_t n = 2; n < limit; n++) {
                  bool prime = true;
                  if (is_cancelled) {
                    return count;
                  }
                  for (int64_t d = 2; d * d <= n && prime; d++) {
                    prime = n % d != 0;
                  }
                  count += prime;
                }
                return count;

