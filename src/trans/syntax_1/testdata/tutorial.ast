      - @279:1
        Func: @280:1
          Annotations:
            - @279:1 onthread
          Name: count_primes
          Params:
            - @280:19
              Name: limit
              Type: @280:26 int
          Return: @280:34 int
          Body: @280:38
            TextPos: 280:39
            Text: |

                int64_t count = 0;
                for (int64_t n = 2; n < limit; n++) {
                  bool prime = true;
                  if (is_cancelled) {
                    return count;
                  }
                  for (int64_t d = 2; d * d <= n && prime; d++) {
                    prime = n % d != 0;
                  }
                  count += prime;
                }
                return count;

