class_name Caller
extends Node

func call_twice(f: Callable) -> void {
  std::invoke([&]() { f.call(); });
  {
    using std::invoke;
    invoke([&](int64_t n) { f.call(n); }, 1);
  }
  int invoke = 2;
  invoke *= 2;
}

// Doubles a variable.
macro double_it(variable) {
  gd.text(tostring(variable) .. " *= 2;")
}
