class_name Radar
extends Node2D

@onready var camera: Camera3D = get_node<Camera3D>("Camera")

// Runs before NOTIFICATION_READY, so before a script's _ready.
ready {
  camera->set_current(true);
}

notif PROCESS {
  gd::print("before");
}

// Runs even when a script overrides _process.
@trace
process(dt: float) {
  if (dt > 0.1) {
    return;
  }
  queue_redraw();
}

notif PROCESS {
  gd::print("after");
}

physics_process(delta: float) {
  gd::print(delta);
}

enter_tree {
  gd::print("enter");
}

exit_tree {
  gd::print("exit");
}

draw {
  draw_circle(Vector2(), 10.0, Color(1, 0, 0));
}
