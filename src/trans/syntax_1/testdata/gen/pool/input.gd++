@pool(100, "strict")
@trace
class_name Bullet
extends Node3D

var speed: float = 20.0

ctor {
  gd::print("created");
}

dtor {
  gd::print("deleted");
}

@recycle ctor {
  speed = 20.0;
}

@recycle
dtor {
  gd::print("kept");
}

func fire() -> void {
  auto other = create Bullet;
  destroy other;
}
