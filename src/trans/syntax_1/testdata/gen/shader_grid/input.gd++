class_name Grids
extends RefCounted

@grid(size)
shader fill(value: float, size: Vector2i) -> Image[rf] {
  return value;
}

@grid("count", 128)
shader ramp(scale: float, count: int, values: PackedFloat32Array) -> PackedFloat32Array {
  return values[index(id)] * scale + float(count);
}

@grid(4, 4, 4)
shader volume(size: Vector3i) -> PackedFloat32Array {
  return float(id.x + id.y + id.z);
}
