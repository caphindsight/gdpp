invoke flags_class(Abilities, [can_jump, can_dash, can_swim])

// A class of flags, written as text in fragments.
macro flags_class(name, flags) {
  gd.text("class " .. name .. " {\n  extends RefCounted\n")
  for _, f in ipairs(flags) do
    gd.text("  var " .. f .. ": bool = false\n")
  end
  gd.text("  func any() -> bool { return " .. gd.join(flags, " || ") .. "; }\n}\n")
}
