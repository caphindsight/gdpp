class_name Pickup
extends Area2D

signal collected(by: Node2D, points: int)

@export var hud: Control

@onready var panel: Control = $Panel

on this.body_entered(body) {
  emit collected(body, 1);
}

on this.body_shape_entered(rid, body: Node2D) {
  gd::print(rid, body);
}

on this.collected {
  queue_destroy this;
}

on hud.resized {
  gd::print("Resized.");
}

on panel.gui_input(event: InputEvent) {
  gd::print(event);
}


func swap(other: Control) -> void {
  hud = other;                      // reconnects on hud.resized
  panel = nullptr;
  hud->set_visible(true);
  if (hud && hud != panel) {
    Gd<Control> copy = hud;
    Control *raw = hud.ptr();
    Gd<Node> node = hud as Gd<Node>;
    gd::print(copy, raw, node);
  }
  panel.create();
  panel.queue_destroy();
}
