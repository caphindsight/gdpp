@pool
class_name Bullet
extends Node3D

@onready var mesh: MeshInstance3D = $Mesh
@onready var trail: Node3D = $Trail
@recycle @onready var start: Vector3 = get_global_position()
@onready var sound: Node = $Sound
@recycle var hits: int

on ready {
  gd::print("first ready");
}

// Runs at each ready, not only the first.
on(what: int) {
  if (what == NOTIFICATION_READY) {
    gd::print("ready in generation ", GENERATION);
  }
}
