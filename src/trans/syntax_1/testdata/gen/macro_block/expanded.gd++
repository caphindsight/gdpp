class_name Grid
extends Node

/// A flag for each direction.
var open_north: bool = false
/// A flag for each direction.
var open_east: bool = false
/// A flag for each direction.
var open_south: bool = false
/// A flag for each direction.
var open_west: bool = false

var cells: int = 64

func neighbors() -> int {
  int n = 0;
  if (open_north) n++;if (open_east) n++;if (open_south) n++;if (open_west) n++;




  return n;
}

func first_open() -> int {
  int i = 0;
  if (open_north) {
    return i;
  }
  i++;
  return -1;
}

on ready {
  open_north = true;
}

impl {
  static int grid_size() { return 8; }
}

class Cell {
  extends RefCounted
}
