class_name Grid
extends Node

/// A flag for each direction.
invoke {
  for _, d in ipairs({ "north", "east", "south", "west" }) do
    gd.var { name = "open_" .. d, type = "bool", init = false, doc = ctx.doc }
  end
}

var cells: int = invoke { gd.text(tostring(8 * 8)) }

func neighbors() -> int {
  int n = 0;
  invoke {
    for _, d in ipairs({ "north", "east", "south", "west" }) do
      gd.text("if (open_" .. d .. ") n++;")
    end
  };
  return n;
}

func first_open() -> int {
  invoke { gd.text("int i = 0;") };
  if (open_north) {
    invoke { gd.text("return i;") };
  }
  invoke { gd.text("i++;") };
  invoke {
    for _, d in ipairs({ "north", "south" }) do
      gd.text("foo();\nif (open_" .. d .. ") return i;\n")
    end
  };
  return -1;
}

func foo() {
  return Variant();
}

func foo_ten_times() -> int {
  invoke {
    for i = 1, 10 do
      gd.text("foo();\n")
    end
  }
  int calls_done = 10;
  return calls_done;
}

on ready {
  invoke { gd.text("open_north = true;") };
}

impl {
  static int grid_size() { invoke { gd.text("return 8;") }; }
}

invoke {
  gd.class { name = "Cell", extends = "RefCounted" }
}
