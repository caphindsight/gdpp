class_name Gun
extends Node

@pool
extern Bullet {
  extends Node3D
}

@scene
extern Spark {
  extends Node3D
}

@scene
@pool
extern Shard {
  extends Node3D
}

extern Shell {
  extends Bullet
}

func fire() -> void {
  Ext<Bullet> b = create Bullet;
  Ext<Spark> s = create Spark;
  Ext<Shard> h = create Shard;
  Ext<Shell> l = create Shell;
  destroy b;
  queue_destroy h;
  destroy s;
  destroy l;
}
