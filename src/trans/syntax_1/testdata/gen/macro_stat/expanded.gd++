class_name Player
extends Node

signal health_changed(value: int)
@export var max_health: int = 100
/// The player's health.
var health: int {
  decl {int64_t health_ = 100;}
  get {return health_;}
  set(value) {health_ = gd::clampi(value, 0, max_health); emit health_changed(health_);}
}
on process(delta: float) {set_health(health_ + int64_t(2.5 * delta));}
signal mana_changed(value: int)
@export var max_mana: int = 50
var mana: int {
  decl {int64_t mana_ = 50;}
  get {return mana_;}
  set(value) {mana_ = gd::clampi(value, 0, max_mana); emit mana_changed(mana_);}
}

// A clamped stat with a changed signal and an exported max.
macro stat(name, max = 100, regen = 0) {
  gd.signal { name = name .. "_changed", params = { "value: int" } }
  gd.var { name = "max_" .. name, type = "int", init = max, annotations = { "export" } }
  local field = name .. "_"
  gd.var { name = name, type = "int", doc = ctx.doc,
           decl = "int64_t " .. field .. " = " .. max .. ";",
           get = "return " .. field .. ";",
           set = field .. " = gd::clampi(value, 0, max_" .. name .. "); emit " .. name .. "_changed(" .. field .. ");" }
  if regen > 0 then
    gd.on { name = "process", param = "delta", param_type = "float",
            body = "set_" .. name .. "(" .. field .. " + int64_t(" .. regen .. " * delta));" }
  end
}
