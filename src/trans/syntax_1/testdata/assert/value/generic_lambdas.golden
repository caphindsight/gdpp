// Generic lambdas, with auto parameters.
auto show = [](const auto &x) { GDPP_ASSERT_VOID("x.size() > 0", x.size() > 0); };
show(std::string("a"));
auto len = [](const auto &x) -> std::size_t { GDPP_ASSERT_VALUE("!x.empty()", !x.empty()); return x.size(); };
GDPP_ASSERT_VALUE("len(std::string(\"ab\")) == 2", len(std::string("ab")) == 2);
return int(len(std::vector<int>{1}));
