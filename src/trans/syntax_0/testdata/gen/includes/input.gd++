class_name Scene
extends Node

import MeshInstance3D
noimport MeshInstance2D

decl {
  Gd<Camera3D> camera_;
}

func ready() -> void {
  if (Engine::get_singleton()->is_editor_hint()) return;
#ifdef GDPP_2D
  Gd<MeshInstance2D> m; // noimport keeps its include out, for builds without GDPP_2D.
#endif
  Gd<Texture2D> t;
}
