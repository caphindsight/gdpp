@icon("res://icons/sword.svg") class Sword {
  extends Item
  @override func _damage() -> int {return 10;}
}
@icon("res://icons/bow.svg") class Bow {
  extends Item
  @override func _damage() -> int {return 6;}
  @override func _range() -> float {return 20;}
}
enum ItemKind {
  SWORD,
  BOW,
}
class ItemFactory {
  @static func make(kind: ItemKind) -> Item {switch (kind) {
case ItemKind::SWORD: return create Sword;
case ItemKind::BOW: return create Bow;
}
return nullptr;}
}

class Item {
  extends Resource
  @virtual func _damage() -> int
  @virtual func _range() -> float { return 1.0; }
}

// A class per item, an enum of their kinds, and a factory that makes them.
macro items(list) {
  local kinds = {}
  for _, item in ipairs(list) do
    table.insert(kinds, gd.upper_snake(item.name))
    gd.class { name = item.name, extends = "Item", annotations = { { "icon", item.icon } }, body = function()
      gd.func { name = "_damage", annotations = { "override" }, ret = "int", body = "return " .. item.damage .. ";" }
      if item.range then
        gd.func { name = "_range", annotations = { "override" }, ret = "float", body = "return " .. item.range .. ";" }
      end
    end }
  end
  gd.enum { name = "ItemKind", values = kinds }
  gd.class { name = "ItemFactory", body = function()
    gd.func { name = "make", annotations = { "static" }, params = { "kind: ItemKind" }, ret = "Item", body = function()
      gd.text("switch (kind) {\n")
      for _, item in ipairs(list) do
        gd.text("case ItemKind::" .. gd.upper_snake(item.name) .. ": return create " .. item.name .. ";\n")
      end
      gd.text("}\nreturn nullptr;")
    end }
  end }
}
