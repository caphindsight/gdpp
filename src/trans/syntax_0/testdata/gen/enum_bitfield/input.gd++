class_name Painter
extends Node

/// Text effects.
@bitfield
enum Effect {
  NONE = 0
  /// Red text.
  RED
  BOLD
  BLINKING
  RED_AND_BOLD = RED | BOLD
  ALL = ~NONE
}

@export var effect: Effect = RED | BOLD
@export_storage var saved: Effect = Effect.BLINKING
var mixed: Effect = ~(Effect.RED ^ BOLD) & ALL

signal changed(effect: Effect)

func paint(extra: Effect = BOLD | BLINKING) -> Effect {
  return effect | extra;
}
