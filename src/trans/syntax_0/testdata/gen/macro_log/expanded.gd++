class_name Fighter
extends Node

var health: int = 100

func hurt(n: int) -> void {
  health -= n;
  UtilityFunctions::print("[Fighter] hurt:", " n=", n, ", health=", health);
}

var label: String = String("shooter: health = ") + String::num_int64(health)

// Prints an event of the class, with the values of some variables.
macro log(event, values = {}) {
  local args = { gd.quote("[" .. ctx.class .. "] " .. event .. ":") }
  for i, v in ipairs(values) do
    table.insert(args, gd.quote((i > 1 and ", " or " ") .. v .. "="))
    table.insert(args, v)
  end
  gd.text("UtilityFunctions::print(" .. gd.join(args, ", ") .. ");")
}

// An expression that describes a value, in a package that knows its own ID.
macro describe(value) {
  gd.text("String(" .. gd.quote(ctx.package.id .. ": " .. value .. " = ") .. ") + String::num_int64(" .. value .. ")")
}
