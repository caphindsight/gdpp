// A #define.
macro define(name, value) {
  gd.text("#define " .. name .. " " .. value)
}

// A #define continued on the next line.
macro define_long(name, value) {
  gd.text("#define " .. name .. " \\\n  (" .. tostring(value) .. ")")
}

// Code that only debug builds compile.
macro debug_only(body) {
  gd.text("#ifdef DEBUG_ENABLED\n" .. tostring(body) .. "\n#endif")
}

// Invocations in a macro's C++.
macro both(n) {
  gd.text("invoke debug_only(code { UtilityFunctions::print(" .. n .. "); }); " .. n .. " += 0;")
}

// A template whose C++ invokes a macro that generates directives: #line names the template's lines.
template checked(name) {
  func ${name}(n: int) -> int {
    invoke debug_only(code { UtilityFunctions::print(n); });
    return n / 2;
  }
}
