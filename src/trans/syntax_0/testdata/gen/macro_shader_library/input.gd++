// Shader blocks for the whole package, from an emitter, from gd.text and from a template.
invoke { gd.shader_library { body = "const float K = 2.0;" } }
invoke { gd.text("shader {\n  float twice(float x) { return x * K; }\n}\n") }
invoke glsl_const(offset, 1.0)

template glsl_const(name, value) {
  shader {
    const float ${gd.upper_snake(name)} = ${value};
  }
}

class Doubler {
  extends RefCounted

  shader run(n: int, v: PackedFloat32Array) -> PackedFloat32Array {
    return twice(v[id]) + OFFSET;
  }
}
