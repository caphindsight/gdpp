// Templates, attributes and constraints before functions and constructors.
template <typename T>
[[nodiscard]] T clamp_to(T v, T lo, T hi) {
	GDPP_ASSERT("lo <= hi", lo <= hi);
	return v < lo ? lo : v > hi ? hi : v;
}
template <class T>
void each(const std::vector<T> &items, const std::function<void(const T &)> &f) {
	for (const auto &item : items) {
		GDPP_ASSERT("&item != nullptr", &item != nullptr);
		f(item);
	}
}
struct Box {
	template <typename T>
	Box(T v) requires std::is_integral_v<T> : size(int(v)) { GDPP_ASSERT_VOID("v >= 0", v >= 0); }
	int size;
};
