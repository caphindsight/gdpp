// A local class: its constructor, destructor and methods return differently from the function around it.
struct Counter {
	int count;
	Counter(int start) : count(start) {
		GDPP_ASSERT_VOID("start >= 0", start >= 0);
	}
	~Counter() {
		GDPP_ASSERT_VOID("count >= 0", count >= 0);
	}
	int next() {
		GDPP_ASSERT("count < 100", count < 100);
		return ++count;
	}
	void reset() { GDPP_ASSERT("count != 0", count != 0); count = 0; }
};
Counter c{1};
GDPP_ASSERT_VOID("c.next() == 2", c.next() == 2);
c.reset();
