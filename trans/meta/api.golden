type Kind int
const Object Kind = 1
const RefCounted Kind = 2
const Extern Kind = 3
const RefCountedExtern Kind = 4
const Enum Kind = 5
type Dependency struct
field Dependency.Name string
field Dependency.Include string
field Dependency.Kind Kind
field Dependency.Values []EnumValue
type EnumValue struct
field EnumValue.Name string
field EnumValue.Value int64
field EnumValue.Doc string
type DeclKind int
const ClassDecl DeclKind = 1
const ExternDecl DeclKind = 2
const EnumDecl DeclKind = 3
type Declaration struct
field Declaration.Name string
field Declaration.Kind DeclKind
field Declaration.Base string
field Declaration.Values []EnumValue
type Options struct
field Options.Dependencies []Dependency
field Options.SourceName string
field Options.HeaderName string
field Options.CodeName string
const Other Kind = 6
field Declaration.Icon string
field Declaration.Tool bool
field Dependency.Gdpp bool
