// Externs that use each other in signatures only need forward declarations, so their headers can include each other.
extern A {
  extends Node
  var peer: B
  func b() -> B
}

extern B {
  extends RefCounted
  func a(x: A) -> A
  signal found(a: A)
}

// A field needs its extern complete.
class User {
  extends Node
  var a: A
  func b() -> B {
    return nullptr;
  }
}
