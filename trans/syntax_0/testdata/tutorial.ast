      - @276:1
        Func: @277:1
          Annotations:
            - @276:1 onthread
          Name: count_primes
          Params:
            - @277:19
              Name: limit
              Type: @277:26 int
          Return: @277:34 int
          Body: @277:38
            TextPos: 277:39
            Text: |

                int64_t count = 0;
                for (int64_t n = 2; n < limit; n++) {
                  bool prime = true;
                  if (is_cancelled) {
                    return count;
                  }
                  for (int64_t d = 2; d * d <= n && prime; d++) {
                    prime = n % d != 0;
                  }
                  count += prime;
                }
                return count;

