      - @270:1
        Func: @271:1
          Annotations:
            - @270:1 onthread
          Name: count_primes
          Params:
            - @271:19
              Name: limit
              Type: @271:26 int
          Return: @271:34 int
          Body: @271:38
            TextPos: 271:39
            Text: |

                int64_t count = 0;
                for (int64_t n = 2; n < limit; n++) {
                  bool prime = true;
                  for (int64_t d = 2; d * d <= n && prime; d++) {
                    prime = n % d != 0;
                  }
                  count += prime;
                }
                return count;

