@game_only
class_name Mob
extends Node

enum Mood { CALM, ANGRY }

@export var mood: Mood = Mood::CALM
var hp: int {
  get { return 10; }
  set(v) { gd::print(v); }
}

signal hit(amount: int)

ctor {
  gd::print("created");
}

dtor {
  gd::print("deleted");
}

func attack(mood: Mood = Mood::ANGRY) -> int {
  return 1;
}

@rpc
func sync() -> void {}

@deferred
func respawn() -> void {}
