// Functions that classes with any base share.
trait Damageable {
  extends Node3D
  func take_damage(amount: int) -> void
  @const func is_alive() -> bool { return true; }
}

class Crate {
  extends RigidBody3D
  implements Damageable

  func take_damage(amount: int) -> void {
    apply_impulse(Vector3(0, amount, 0));
  }

  func _on_body_entered(body: Node3D) -> void {
    // Checked at runtime: null if the body's
    // class doesn't implement Damageable.
    if (auto target = body as Gd<Damageable>) {
      // A C++ virtual call, not an engine
      // call, so it's much faster.
      target->take_damage(10);
    }
  }
}
