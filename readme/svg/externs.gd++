class_name Car
extends Node3D

@export var terrain: Terrain

on physics_process {
  Vector3 pos = get_position();
  pos.y = terrain->height_at(pos.x, pos.z);
  set_position(pos);
}

// A class that lives elsewhere: in another
// package, GDExtension or script.
// Its members are called by name.
extern Terrain {
  extends Node3D
  func height_at(x: float, z: float) -> float
}
