// Outside the class, in its header.
@global decl {
  #include <random>
}

// In the class, in its header.
decl {
  std::mt19937 rng_{std::random_device{}()};
  int64_t roll(int64_t sides);
}

// In its source file. `This` names the
// current class, like `Self` in Rust.
impl {
  int64_t This::roll(int64_t sides) {
    std::uniform_int_distribution<int64_t> d(1, sides);
    return d(rng_);
  }
}
