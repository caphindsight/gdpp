// The file-level class: the rest of the file.
// @icon is its icon in the editor.
@icon("res://icons/player.svg")
class_name Player
extends CharacterBody3D

var coins: int

// An inline class. Any number of them.
// Without extends, a class extends RefCounted.
class Coin {
  extends Area3D
  var value: int = 1
}
