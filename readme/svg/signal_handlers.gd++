@onready var start: Button = $Start
@export var player: Player

// When the button in the variable emits pressed. It follows
// the variable: setting another button reconnects it.
on start.pressed {
  begin();
}

// The signal's parameters, whose types GD++ knows.
on player.health_changed(health) {
  bar->set_value(health);
}

// A signal of this object. With @async, it can await.
@async
on this.visibility_changed {
  await get_tree()->create_timer(0.5)->timeout;
  gd::print("Shown or hidden half a second ago.");
}
