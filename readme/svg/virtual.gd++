class_name Weapon
extends Node3D

// Scripts can override it, and call it as
// damage().
@virtual
func _damage() -> int {
  return 10;
}

class Axe {
  extends Weapon

  @override
  func _damage() -> int {
    return 15;
  }
}

class Sword {
  extends Weapon

  // Nothing can override it further.
  @override("final")
  func _damage() -> int {
    return 25;
  }
}
