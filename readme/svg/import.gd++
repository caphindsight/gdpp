// Includes are automatic, but GD++ can't see
// the Material behind auto. noimport removes
// an include.
import Material

func tint(mesh: MeshInstance3D, color: Color) -> void {
  auto material = mesh->get_active_material(0);
  auto standard = material as StandardMaterial3D *;
  if (standard) {
    standard->set_albedo(color);
  }
}
