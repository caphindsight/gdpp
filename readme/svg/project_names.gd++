// With [names] in the package's .gd++pkg, e.g. actions = "Action":
// C++ names of input actions, groups and layers, which the compiler
// checks. Godot never sees them.
@export_flags_3d_physics
var mask: int = Physics3D::PLAYER | Physics3D::WORLD

on physics_process {
  if (Input::get_singleton()->is_action_pressed(Action::jump)) {
    jump();
  }
}
