func spawn() -> void {
  // A node: a pointer.
  Node3D *marker = create Node3D;
  // A resource: a reference, which deletes the
  // object with the last one.
  Ref<ArrayMesh> mesh = create ArrayMesh;
  // An extern.
  Ext<Terrain> terrain = create Terrain;
  // A pool class: reused from its pool.
  Bullet *bullet = create Bullet;

  // Deletes it.
  destroy marker;
  // Gives it back to the pool.
  destroy bullet;
}
