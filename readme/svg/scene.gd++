// Calling `create Enemy` in code instantiates this scene.
@scene("res://enemy.tscn")
class_name Enemy
extends CharacterBody3D

class Spawner {
  extends Node3D

  func spawn() -> void {
    // The scene's root, with its children.
    Enemy *enemy = create Enemy;
    // Null if the root isn't an Enemy.
    if (enemy) {
      add_child(enemy);
    }
  }
}
