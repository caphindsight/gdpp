class_name Slime
extends CharacterBody2D

on physics_process(delta: float) {
  state_machine_tick();
}

// Lua code that generates code. An advanced
// feature: use it sparingly.
macro state_machine(states) {
  // An enum of the states.
  gd.enum { name = "State",
    values = gd.map(states, gd.upper_snake) }
  gd.var { name = "state", type = "State" }
  // Runs the current state's update.
  gd.func { name = "state_machine_tick", ret = "void",
    annotations = { "private" },
    body = function()
      gd.text("switch (state) {\n")
      for _, s in ipairs(states) do
        gd.text("case State::" .. gd.upper_snake(s)
          .. ": state = update_" .. gd.snake(s)
          .. "(); break;\n")
      end
      gd.text("}")
    end }
}

invoke state_machine([Patrol, Chase])

// Wanders until it sees the player.
@private
func update_patrol() -> State {
  return sees_player() ? State::CHASE : State::PATROL;
}

// Follows the player until it loses sight of them.
@private
func update_chase() -> State {
  return sees_player() ? State::CHASE : State::PATROL;
}
