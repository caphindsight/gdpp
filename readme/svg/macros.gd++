class_name Player
extends Node

@export var health: int = 100

invoke flags([invincible, flying])

func hurt(n: int) -> void {
  if (invincible) return;
  health -= n;
  invoke log("hurt", [n, health]);
}

// An exported flag for each name: a loop, which templates don't have.
macro flags(names) {
  for _, name in ipairs(names) do
    gd.var { name = name, type = "bool", init = false, annotations = { "export" } }
  end
}

// Prints an event, with the class's name: C++ code, which templates don't generate.
macro log(event, values = {}) {
  local args = { gd.quote(ctx.class .. ": " .. event) }
  for _, v in ipairs(values) do table.insert(args, v) end
  gd.text("gd::print(" .. gd.join(args, ", ") .. ")")
}
