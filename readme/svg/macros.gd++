class_name Player
extends Node

invoke stat(health, max = 100)
invoke stat(mana, max = 50)

func hurt(n: int) -> void {
  health -= n;
  invoke log("hurt", [n, health]);
}

// An exported stat, and a function that refills it.
macro stat(name, max = 100) {
  gd.var { name = name, type = "int", init = max, annotations = { "export" } }
  gd.func { name = "refill_" .. name, ret = "void", body = name .. " = " .. max .. ";" }
}

// Prints an event, with the class's name.
macro log(event, values = {}) {
  local args = { gd.quote(ctx.class .. ": " .. event) }
  for _, v in ipairs(values) do table.insert(args, v) end
  gd.text("gd::print(" .. gd.join(args, ", ") .. ")")
}
