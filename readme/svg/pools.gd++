@pool
class_name Bullet
extends Area3D

@recycle var speed: float = 20.0

ctor {
  gd::print("Created.");
}

@recycle ctor {
  gd::print("Reused.");
}

@recycle dtor {
  gd::print("Kept for later.");
}

class Gun {
  extends Node3D

  func fire() -> void {
    add_child(create Bullet);
  }

  func _on_hit(bullet: Bullet) -> void {
    destroy bullet;
  }
}
