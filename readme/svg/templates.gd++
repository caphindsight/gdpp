class_name Score
extends Node

// Each invocation puts the template's code here.
invoke counter(points)
invoke counter(lives, start = 3)

// GD++ code with holes, which hold Lua.
template counter(name, start = 0) {
  var ${name}: int = ${start}
  signal ${name}_changed(value: int)

  func add_${name}(n: int) -> void {
    ${name} += n;
    emit ${name}_changed(${name});
  }
}
