signal health_changed(health: int)

enum Suit { DIAMONDS, CLUBS, SPADES, HEARTS }
enum MAX_PLAYERS = 4

func _on_body_entered(body: Node3D) -> void {
  Player *player = body as Player *;   // null if body isn't a Player
  if (player) {
    player->hurt(10);
    emit health_changed(player->health);
  }
}
